# Render environment variables — kopyalayıp .env olarak kaydedin, değerleri doldurun

# Groq API anahtarı (BYOK — kullanıcı tarayıcısında saklar, sunucuya gerek yok)
GROQ_API_KEY=

# CORS — sadece bu origin /api/refresh'i çağırabilir
CORS_ALLOWED_ORIGINS=https://news-ai-platform-abze.onrender.com

# JSON log formatı (Render logları için)
LOG_JSON=true

# Log seviyesi
LOG_LEVEL=INFO

# Sunucu portu
PORT=8000
